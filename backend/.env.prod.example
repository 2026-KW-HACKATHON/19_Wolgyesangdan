# 운영 서버 환경변수 예시. 실제 값은 서버(또는 배포 도구)의 환경변수로 넣고, 값을 채운 파일은 커밋하지 마세요.
# Dockerfile이 SPRING_PROFILES_ACTIVE=prod 를 기본으로 설정합니다.
# 주의: docker --env-file은 줄 끝 주석을 값으로 읽으므로 주석은 항상 별도 줄에 씁니다.

# ── 필수 (없으면 서버가 뜨지 않음) ──
# DB 주소 (예: RDS 엔드포인트)
DB_HOST=your-db-host
DB_NAME=wolgyesangdan
DB_USERNAME=wolgyesangdan
DB_PASSWORD=change_me

# 로컬과 다른 랜덤 값 사용 (openssl rand -base64 48)
JWT_SECRET=change_me

# 클라이언트 시크릿은 배포 전에 카카오 콘솔에서 재발급 권장
KAKAO_REST_API_KEY=change_me
KAKAO_CLIENT_SECRET=change_me
# 카카오 콘솔의 REST API 키·JavaScript 키 양쪽에 같은 주소로 등록해야 함
KAKAO_REDIRECT_URI=https://your-frontend-domain/oauth/kakao/callback

# 프론트 주소. 여러 개면 쉼표로 구분
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# ── 선택 ──
DB_PORT=3306
JPA_DDL_AUTO=update
